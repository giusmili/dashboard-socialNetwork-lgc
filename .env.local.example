# TikTok Business API — voir https://business-api.tiktok.com/portal/docs
# Token + ID obtenus en liant le compte TikTok Business @lagrandeclasse
# à une app créée sur TikTok for Developers (scope accès au compte, pas Ads).
TIKTOK_BUSINESS_ACCESS_TOKEN=
TIKTOK_BUSINESS_ID=

# Secret partagé pour autoriser le cron quotidien (/api/cron/tiktok-snapshot)
# Header attendu : Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
